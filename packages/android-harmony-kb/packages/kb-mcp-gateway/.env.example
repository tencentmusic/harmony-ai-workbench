# kb-mcp-gateway 环境变量模板
#
# 本地开发：
#   cp .env.example .env.local
#   npm run mcp:gateway
#
# 测试服 / 生产（Gateway 与工台同机）：
#   cp .env.example .env.production
#   按注释改 WORKBENCH_URL；源码、知识库和文档路径统一改 workspace-apps.json
#   npm run mcp:gateway:prod
#
# 优先级（后者覆盖前者，shell 里 export 的变量最高）：
#   .env → .env.local | .env.production → 进程环境变量

# ── 1. 工台连接与项目配置 ──
# 本地 dev 工台 npm run dev 默认 3100；测试服工台 8082
WORKBENCH_URL=http://127.0.0.1:3100
# 选择根 config/workspace-apps.json 中的路径环境；源码和知识库路径不在本文件重复配置。
WORKSPACE_PROFILE=local-windows

# ── 2. Gateway 监听 ──
KB_MCP_HOST=127.0.0.1
KB_MCP_PORT=8420

# 项目源码、外部业务知识库、内置 KB 和迁移文档由 workspace-apps.json + WORKSPACE_PROFILE 统一解析。

# ── 3. 遥测（写入工台看板）──
KB_TELEMETRY_CONSUMER=kb-mcp-for-zc
# KB_TELEMETRY_ENDPOINT=http://127.0.0.1:3100/api/kb-telemetry/v1/events

# ── 4. L2 CodeGraph 性能（可选）──
# 多 module 并行 search 并发数（默认 4，上限 16）
# KB_CODEGRAPH_SEARCH_CONCURRENCY=4
# 同时 open 的 CodeGraph SDK 实例上限（默认 24）
# KB_CODEGRAPH_CACHE_MAX=24
# explore 返回文本上限（字符，默认 24000；允许 4000–100000）
# KB_CODEGRAPH_MAX_TEXT_CHARS=24000

# ── 5. L3 / Gateway 性能（可选）──
# grep 无 path_prefix 时 walk fallback 上限（默认 8000，原 12000）
# KB_MCP_GREP_WALK_BROAD_MAX_FILES=8000
# drawable 扫描结果缓存 TTL（毫秒，默认 300000）
# KB_MCP_DRAWABLE_CACHE_MS=300000
# L1 feature context pack 缓存 TTL（毫秒，默认 60000）
# KB_MCP_CONTEXT_PACK_CACHE_MS=60000
# MCP Server 实例缓存（同 Bearer 复用，默认 4h / 最多 64 个）
# KB_MCP_SERVER_CACHE_TTL_MS=14400000
# KB_MCP_SERVER_CACHE_MAX=64

# smoke test: npm run mcp:gateway:test
# KB_MCP_TEST_TOKEN=hm_...
