# kb-mcp-for-codegraph 环境变量模板（本地开发）
#   cp .env.example .env.local && npm run mcp:codegraph

WORKBENCH_URL=http://127.0.0.1:3100
# 选择根 config/workspace-apps.json 中的路径环境。
WORKSPACE_PROFILE=local-windows
KB_MCP_CODEGRAPH_HOST=127.0.0.1
KB_MCP_CODEGRAPH_PORT=8421
# explore 返回文本上限（字符，默认 24000；允许 4000–100000）
# KB_CODEGRAPH_MAX_TEXT_CHARS=24000

# 所有已配置项目的源码路径统一来自 config/workspace-apps.json 的 local-windows profile。

KB_TELEMETRY_CONSUMER=kb-mcp-for-codegraph
KB_TELEMETRY_ENDPOINT=http://127.0.0.1:3100/api/kb-telemetry/v1/events
