{
  "name": "kg-harmony-ai-workbench",
  "version": "1.11.3",
  "private": true,
  "workspaces": [
    "packages/android-harmony-kb",
    "packages/workspace-config"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "//dev": "本地开发",
    "dev": "node scripts/start-dev.mjs",
    "typecheck": "node scripts/check-changelog.mjs && npm run test:architecture && tsc --noEmit",
    "test:architecture": "node scripts/test-architecture.mjs",
    "check:changelog": "node scripts/check-changelog.mjs",
    "opencode:dev": "node scripts/start-opencode-dev.mjs",
    "opencode:integration:dev": "node scripts/start-opencode-integration.mjs",
    "telemetry:bridge": "node scripts/start-kb-telemetry-bridge.mjs",
    "telemetry:inspect": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types scripts/inspect-kb-telemetry-db.mjs",
    "telemetry:purge-test": "node scripts/purge-kb-telemetry-test-data.mjs",
    "//kb": "内置双端知识库",
    "kb:setup": "npm run setup --workspace android-harmony-kb --",
    "kb:status": "npm run kb:status --workspace android-harmony-kb",
    "kb:validate": "npm run validate --workspace android-harmony-kb",
    "kb:test": "npm run test:v0.2 --workspace android-harmony-kb",
    "kb:test:codegraph-config": "npm run test:codegraph-config --workspace android-harmony-kb",
    "kb:test:migration-wiki": "npm run test:migration-wiki --workspace android-harmony-kb",
    "kb:test:knowledge-sources": "npm run test:knowledge-sources --workspace android-harmony-kb",
    "kb:codegraph-init": "npm run kb:codegraph-init --workspace android-harmony-kb --",
    "kb:codegraph-sync": "npm run kb:codegraph-sync --workspace android-harmony-kb --",
    "kb:sync:l2:check": "npm run kb-sync:l2:check --workspace android-harmony-kb",
    "kb:sync:l2": "npm run kb-sync:l2 --workspace android-harmony-kb",
    "kb:mcp": "npm run mcp:harmony-kb --workspace android-harmony-kb",
    "kb:mcp:gateway": "npm run mcp:gateway --workspace android-harmony-kb",
    "kb:mcp:codegraph": "npm run mcp:codegraph --workspace android-harmony-kb",
    "dev:stack": "node scripts/start-dev-stack.mjs",
    "cloud-agent:worker": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types workers/cloud-agent/index.mjs",
    "cloud-agent:ops": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types scripts/cloud-agent-ops.mjs",
    "cloud-agent:smoke:runtime": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types scripts/smoke-cloud-agent-runtime.mjs",
    "cloud-agent:smoke:live": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types scripts/smoke-cloud-agent-live.mjs",
    "test:cloud-agent": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types --test --test-concurrency=4 src/server/modules/cloud-agent/*.test.ts src/features/cloud-agent/*.test.ts",
    "prepare:opencode-workspace": "node scripts/prepare-opencode-workspace.mjs",
    "render:opencode-config": "node scripts/render-opencode-config.mjs",
    "validate:workspace-apps": "node scripts/validate-workspace-apps.mjs",
    "test:workspace-apps": "node scripts/test-workspace-apps.mjs",
    "test:knowledge-portal": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types scripts/test-knowledge-portal.mjs",
    "test:knowledge-access-security": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types scripts/test-knowledge-access-security.mjs",
    "test:migration-case-links": "node scripts/test-migration-case-links.mjs",
    "test:chat-attachments": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types scripts/test-chat-attachments.mjs",
    "test:opencode-asset-access": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types scripts/test-opencode-asset-access.mjs",
    "//build": "构建与生产进程",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "//db": "数据库（schema 权威：prisma/schema.prisma）",
    "db:push": "prisma db push",
    "db:push:prod": "node scripts/db-push-prod.mjs",
    "//deploy": "部署与运维（生产机需全局 pm2）",
    "deploy": "node scripts/deploy-background.mjs",
    "service:restart": "node scripts/restart-service.mjs",
    "service:install-cron": "bash scripts/install-cron.sh",
    "//test": "开发自测（OpenCode / prompt 逻辑，非 CI 门禁）",
    "test:integration-api": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types scripts/test-integration-api.mjs",
    "test:integration-domain": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types scripts/test-integration-domain.mjs",
    "test:integration-projects": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types scripts/test-integration-projects.mjs",
    "test:integration-git": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types scripts/test-integration-git.mjs",
    "test:integration-large-binary": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types scripts/test-integration-large-binary.mjs",
    "test:integration-image-size": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types scripts/test-integration-image-size.mjs",
    "test:integration-opencode": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types scripts/test-integration-opencode.mjs",
    "test:integration-opencode-cleanup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types scripts/test-integration-opencode-cleanup.mjs",
    "test:integration-recovery": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types scripts/test-integration-recovery.mjs",
    "test:integration-runner": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types scripts/test-integration-runner.mjs",
    "test:integration-store": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types scripts/test-integration-store-contract.mjs",
    "test:integration-ui": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types scripts/test-integration-ui-contract.mjs",
    "test:integration-worker": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types scripts/test-integration-worker.mjs",
    "test:integration-all": "node scripts/test-integration-all.mjs",
    "test:opencode-class-hint": "node --experimental-strip-types scripts/test-opencode-class-hint.mjs",
    "test:opencode-image": "node scripts/test-opencode-image-events.mjs",
    "test:opencode-image-prompt": "node --experimental-strip-types scripts/test-opencode-image-prompt.mjs",
    "test:opencode-url-prompt": "node --experimental-strip-types scripts/test-opencode-url-prompt.mjs",
    "test:opencode-knowledge": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types scripts/test-opencode-knowledge-context.mjs",
    "test:opencode-intent": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types scripts/test-opencode-intent.mjs",
    "test:opencode-session-continue": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types scripts/test-opencode-session-continue.mjs",
    "test:opencode-session-reconcile": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types scripts/test-opencode-session-reconcile.mjs",
    "test:opencode-stream": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types scripts/test-opencode-stream.mjs",
    "test:module-prefix-utils": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types scripts/test-module-prefix-utils.mjs",
    "test:android-workspace-path": "node --experimental-strip-types scripts/test-android-workspace-path.mjs",
    "repo-sync:worker": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types workers/repo-sync/index.mjs",
    "test:repo-sync": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types scripts/test-repo-sync.mjs",
    "test:repo-sync-follow-up": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types scripts/test-repo-sync-follow-up.mjs",
    "test:repo-sync-integration": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types scripts/test-repo-sync-integration.mjs",
    "verify:opencode-models": "node scripts/verify-opencode-models.mjs",
    "test:package-comparison": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types scripts/test-package-comparison.mjs",
    "test:package-comparison-api": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types scripts/test-package-comparison-api.mjs",
    "test:image-compression": "python3 scripts/test-image-compression.py",
    "test:deploy-harness-runtime": "node --test scripts/test-deploy-harness-runtime.mjs",
    "test:image-compression-api": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --experimental-strip-types scripts/test-image-compression-api.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@ant-design/plots": "^2.3.3",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@antv/g2": "^5.4.8",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@prisma/client": "^6.3.1",
    "antd": "^5.29.3",
    "jszip": "^3.10.1",
    "mammoth": "^1.13.0",
    "next": "15.5.26",
    "parse5": "^8.0.1",
    "playwright-core": "^1.63.0",
    "postcss-value-parser": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-resizable": "^4.0.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "sharp": "0.35.4",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/react-resizable": "^3.0.8",
    "prisma": "^6.3.1",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "nanoid": "3.3.19",
    "postcss": "8.5.28",
    "sharp": "0.35.4"
  }
}
