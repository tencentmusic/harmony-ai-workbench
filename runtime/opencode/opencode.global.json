{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "share": "disabled",
  "instructions": ["AGENTS.md"],
  "model": "sub2api/gpt-5.6-luna",
  "small_model": "sub2api/gpt-5.6-luna",
  "provider": {
    "sub2api": {
      "npm": "@ai-sdk/openai",
      "name": "公司 Sub2API",
      "env": ["SUB2API_API_KEY", "OPENAI_API_KEY"],
      "options": {
        "baseURL": "https://model-gateway.example/v1",
        "apiKey": "{env:SUB2API_API_KEY}"
      },
      "models": {
        "gpt-5.6-luna": {
          "name": "GPT 5.6 Luna",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "edit": "deny",
    "bash": "deny",
    "task": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": {
      "*": "deny"
    }
  }
}
