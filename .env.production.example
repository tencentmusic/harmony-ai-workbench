# 测试服 / 生产环境变量模板。
# 项目源码、App 模块、知识库、迁移文档及 Webhook 分支规则统一维护在 config/workspace-apps.json。
# 复制为 .env.production 后填写真实密钥；该文件由 Next.js、PM2、OpenCode 和 KB MCP 部署共同读取。

# ── 1. 部署、数据库与安全（必填）────────────────────────────────────────
DEPLOY_PORT="8082"
# SQLite 相对路径按 prisma/schema.prisma 所在目录解析，实际文件为 prisma/data.prod.db。
DATABASE_URL="file:./data.prod.db"
# 可选：仅覆盖部署脚本使用的数据库连接串。
# DEPLOY_DATABASE_URL="file:./data.prod.db"
ADMIN_SECRET="replace-with-long-random"
TOKEN_PEPPER="replace-with-long-random"
APP_CIPHER_KEY="replace-with-32-plus-chars-secret-string"

# ── 2. 可插拔项目配置（必填）────────────────────────────────────────────
# 只选择 config/workspace-apps.json 中的路径 profile，不在 env 重复配置仓库路径、模块或知识库。
WORKSPACE_PROFILE="test-server"
# 仅在需要使用另一份项目清单时设置；相对路径按仓库根目录解析。
# WORKSPACE_APPS_CONFIG="config/workspace-apps.json"

# ── 3. 工台地址与反向代理（按部署方式选填）──────────────────────────────
# 知识门户由 Workbench 原生提供；两个 MCP 服务通常只监听回环地址，由工台统一反代。
# KB_MCP_PUBLIC_URL="https://workbench.example.com/kb-mcp-gateway"
# NEXT_PUBLIC_KB_MCP_URL="/kb-mcp-gateway"
# KB_MCP_PROXY_TARGET="http://127.0.0.1:8420"
# KB_MCP_CODEGRAPH_PROXY_TARGET="http://127.0.0.1:8421"
# CodeGraph explore 返回文本上限，默认 24000 字符，防止宽泛查询占满 Agent 上下文。
# KB_CODEGRAPH_MAX_TEXT_CHARS=24000
# WORKBENCH_PUBLIC_URL="https://workbench.example.com"

# ── 4. AI 员工 OpenCode（必填）──────────────────────────────────────────
OPENCODE_BASE_URL="http://127.0.0.1:4098"
# 可选；默认使用 <workbench>/.runtime/harmony-opencode-workspace。
# OPENCODE_AGENT_CWD="/absolute/path/to/harmony-opencode-workspace"
OPENCODE_TIMEOUT_MS="120000"
# 必须与 runtime/opencode/opencode.global.json 的 model 一致。
OPENCODE_MODEL="sub2api/gpt-5.6-luna"
OPENCODE_SERVER_USERNAME="opencode"
OPENCODE_SERVER_PASSWORD="replace-with-random-64-hex-characters"
SUB2API_API_KEY="replace-with-sub2api-api-key"
# 仅兼容需要 OpenAI 标准变量名的运行时，可与 SUB2API_API_KEY 相同。
# OPENAI_API_KEY="replace-with-sub2api-api-key"

# ── 5. 云 Agent / 集成 OpenCode（必填）──────────────────────────────────
OPENCODE_INTEGRATION_BASE_URL="http://127.0.0.1:4110"
OPENCODE_INTEGRATION_SERVER_USERNAME="opencode"
OPENCODE_INTEGRATION_SERVER_PASSWORD="replace-with-another-random-64-hex-secret"
# OPENCODE_INTEGRATION_AGENT_CWD="/absolute/path/to/harmony-integration-runtime"
# OPENCODE_INTEGRATION_PORT="4110"
# 每个任务 worktree 的父目录；默认使用系统临时目录。
# HARMONY_INTEGRATION_RUNTIME_ROOT="/absolute/private/path/harmony-integration-runs"
HARMONY_INTEGRATION_MAX_DIFF_BYTES="2097152"
HARMONY_INTEGRATION_MAX_CHANGED_FILES="120"
HARMONY_INTEGRATION_WORKER_CONCURRENCY="2"

# ── 6. 类索引与上下文预读（可选，以下均为默认值）────────────────────────
# 扫描根目录来自 workspace-apps.json 的 sources.android.index_roots，不再通过 env 配置。
ANDROID_CLASS_INDEX_TTL_MS="86400000"
ANDROID_CLASS_INDEX_PREWARM_ON_BOOT="1"
ANDROID_CLASS_INDEX_PREWARM_DELAY_MS="5000"
ANDROID_CLASS_PREREAD="1"
ANDROID_CLASS_PREREAD_LINES="200"
ANDROID_CLASS_PREREAD_MAX_FILES="1"
ANDROID_CLASS_PREREAD_MAX_CHARS="8000"

# ── 7. 知识库 MCP 遥测（可选）───────────────────────────────────────────
# 默认按 DEPLOY_PORT 推导本机上报地址；跨机部署时显式设置。
# KB_TELEMETRY_ENDPOINT="https://workbench.example.com/api/kb-telemetry/v1/events"
# KB_TELEMETRY_API_KEY="replace-with-telemetry-key"
# KB_TELEMETRY_ENABLED="0"

# ── 8. 源码同步 Webhook（必填）──────────────────────────────────────────
# 仓库匹配、监听分支及变更动作维护在 workspace-apps.json 各资源的 sync 节点。
REPO_SYNC_WEBHOOK_SECRET="replace-with-webhook-secret"
# REPO_SYNC_DEPLOYMENT_ID="production"
# REPO_SYNC_NOTIFY_WEBHOOK="https://example.invalid/bot-webhook"

# ── 9. 包体对比（可选）──────────────────────────────────────────────────
# 多进程部署时必须使用共享、持久化的私有目录；完整规则见 docs/features/package-comparison.md。
# PACKAGE_STORAGE_DIR="/absolute/path/to/package-comparison"
# PACKAGE_COMPARISON_CONFIG="/absolute/path/to/package-comparison.json"
# PACKAGE_UPLOAD_BYTES="536870912"
# PACKAGE_FILE_BYTES="268435456"
# PACKAGE_EXPANDED_BYTES="2147483648"
# PACKAGE_FILE_COUNT="30000"
# PACKAGE_ANALYSIS_TIMEOUT_MS="180000"
# PACKAGE_ANALYSIS_CONCURRENCY="1"
# PACKAGE_RETENTION_DAYS="30"

# ── 10. 运行工具（可选）─────────────────────────────────────────────────
# Node、pm2 或 OpenCode 不在系统 PATH 时再配置；env 加载器不会展开 ${HOME}。
# NODE_BIN_DIR="/absolute/path/to/node/bin"
# OPENCODE_HOME="/absolute/path/to/opencode"
# OPENCODE_BIN="/absolute/path/to/opencode"

# ── 11. 历史任务兼容（新部署不要配置）──────────────────────────────────
# 仅用于读取旧集成任务中已保存的项目 id；新任务完全读取 workspace-apps.json。
# 删除前必须确认数据库中没有依赖旧 id 的历史任务。
# HARMONY_INTEGRATION_PROJECTS='[{"id":"legacy","label":"历史项目","repoRoot":"/absolute/path/to/harmony-repo","defaultTargetBranch":"release"}]'

# 12. 云Agent（App、分支和源码范围统一配置在 workspace-apps.json）
# 当前云Agent使用 SSH + 鉴权 MR Webhook，不需要 GitLab API Token；仅显式选择 delivery.transport=api 时才配置下项。
# CLOUD_AGENT_GITLAB_TOKEN="replace-with-project-api-token"
# 执行机 SSH 负责拉取/推送和知识MR push options；Webhook Secret仍需配置。不自动创建代码MR、不自动合入。
# 企业微信群通知：密钥URL只存服务器环境，不提交Git。按工台personCode显式映射userid。
# CLOUD_AGENT_WECOM_WEBHOOK="https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=replace-me"
# CLOUD_AGENT_WECOM_DEFAULT_USER="your-wecom-userid"
# CLOUD_AGENT_WECOM_DEFAULT_MOBILE="13800000000"
# CLOUD_AGENT_WECOM_USERS='{"employee-code":{"userId":"wecom-userid"}}'
# CLOUD_AGENT_PUBLIC_URL="https://workbench.example.com"
# DevEco 安装在非默认位置时填实际安装目录。
# DEVECO_HOME="/absolute/path/to/DevEco Studio"
# 命令行构建必须配置 HarmonyOS SDK 根目录（包含 default/），不是 tools/ 或 openharmony/；修改后重启 Worker。
# DEVECO_SDK_HOME="/absolute/path/to/DevEco Studio/sdk"
# 非默认安装目录必须设置上项为安装根目录（不是 tools），并重启 Worker；否则原生构建预检会拒绝执行。
# 同机活跃分析/转译实例数，上限 2；等待补料或审批不占实例。
# CLOUD_AGENT_CONCURRENCY="2"
# Git 缓存和 Worker 锁目录，默认 .runtime/cloud-agent；必须是本机私有目录。
# CLOUD_AGENT_RUNTIME_ROOT="/absolute/private/path/cloud-agent-runtime"
# 仅归档已结算、无引用的旧构建备份；原件可恢复，不永久删除。
# CLOUD_AGENT_ARTIFACT_AUTO_ARCHIVE="1"
# CLOUD_AGENT_ARTIFACT_RETENTION_DAYS="7"
# 源码工作树可独立放短目录；只影响新任务，旧任务需运维迁移。
# CLOUD_AGENT_WORKTREE_ROOT="/var/lib/harmony-workbench/worktrees"
# 模型网关地址，默认取集成 OpenCode 模板；密钥复用 SUB2API_API_KEY。
# CLOUD_AGENT_MODEL_BASE_URL="https://model-gateway.example/v1"
# 附件持久化私有目录，默认 data/cloud-agent/materials；与 SQLite 配套备份，Web/Worker 共用。
# CLOUD_AGENT_MATERIAL_ROOT="/absolute/private/path/cloud-agent-materials"
# 视频抽帧依赖系统 FFmpeg/FFprobe，默认从 PATH 查找；无音频转写。
# CLOUD_AGENT_FFMPEG_BIN="/usr/bin/ffmpeg"
# CLOUD_AGENT_FFPROBE_BIN="/usr/bin/ffprobe"
# Harness 独立包根，默认相邻仓 androidtoharmonyharness/android-harmony-migration-harness。
# CLOUD_AGENT_HARNESS_ROOT="/absolute/path/to/android-harmony-migration-harness"
# Python 可执行文件，Linux/macOS 默认 python3。
# CLOUD_AGENT_HARNESS_PYTHON="/usr/bin/python3"
# 安全预算而非固定抽帧数；模型自主选择时间点、补帧与批次，默认120，上限600。
# CLOUD_AGENT_VIDEO_FRAME_BUDGET="120"
# 原型渲染浏览器；不填使用本机 Chrome。需支持沙箱，禁止用禁用沙箱参数绕过环境问题。
# CLOUD_AGENT_CHROMIUM_BIN="/usr/bin/chromium"
# 新建任务工作区及构建前最低可用空间（GiB，1-1024）；不足时阻塞，不自动删档。
# CLOUD_AGENT_MIN_FREE_GIB="5"
