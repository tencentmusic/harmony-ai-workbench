# 本地开发环境变量模板。
# 项目源码、App 模块、知识库、迁移文档及 Webhook 分支规则统一维护在 config/workspace-apps.json。
# 本文件只保存当前机器的运行参数和密钥；复制为 .env 后填写，禁止提交真实密钥。

# ── 1. 数据库与安全（必填）──────────────────────────────────────────────
# SQLite 相对路径按 prisma/schema.prisma 所在目录解析，实际文件为 prisma/data.db。
DATABASE_URL="file:./data.db"
# 管理后台 x-admin-secret、API Token 哈希盐、模型密钥加密密钥；生产环境必须分别使用强随机值。
ADMIN_SECRET="replace-with-long-random"
TOKEN_PEPPER="replace-with-long-random"
APP_CIPHER_KEY="replace-with-32-plus-chars-secret-string"

# ── 2. 可插拔项目配置（必填）────────────────────────────────────────────
# 只选择 config/workspace-apps.json 中的路径 profile，不在 env 重复配置仓库路径、模块或知识库。
WORKSPACE_PROFILE="local-windows"
# 仅在需要使用另一份项目清单时设置；相对路径按仓库根目录解析。
# WORKSPACE_APPS_CONFIG="config/workspace-apps.json"

# ── 3. 工台地址与反向代理（按部署方式选填）──────────────────────────────
# 知识门户由 Workbench 原生提供，无独立文档站地址或端口。
# MCP 接入页展示地址、浏览器直连地址及工台反代目标。
# KB_MCP_PUBLIC_URL="http://127.0.0.1:8420"
# NEXT_PUBLIC_KB_MCP_URL="http://127.0.0.1:8420"
# KB_MCP_PROXY_TARGET="http://127.0.0.1:8420"
# KB_MCP_CODEGRAPH_PROXY_TARGET="http://127.0.0.1:8421"
# CodeGraph explore 返回文本上限，默认 24000 字符，防止宽泛查询占满 Agent 上下文。
# KB_CODEGRAPH_MAX_TEXT_CHARS=24000
# MCP 遥测自动推导接口地址时使用；默认按当前工台端口生成。
# WORKBENCH_PUBLIC_URL="http://127.0.0.1:3100"

# ── 4. AI 员工 OpenCode（本地 dev:stack 必填）───────────────────────────
OPENCODE_BASE_URL="http://127.0.0.1:4098"
# 可选；默认使用 <workbench>/.runtime/harmony-opencode-workspace，必须是存在且可写的绝对路径。
# OPENCODE_AGENT_CWD="C:/absolute/path/to/harmony-opencode-workspace"
OPENCODE_TIMEOUT_MS="120000"
# 必须与 runtime/opencode/opencode.global.json 的 model 一致。
OPENCODE_MODEL="sub2api/gpt-5.6-luna"
OPENCODE_SERVER_USERNAME="opencode"
# 使用 openssl rand -hex 32 生成 64 位十六进制密码。
OPENCODE_SERVER_PASSWORD="replace-with-random-64-hex-characters"
# 公司模型网关密钥；OPENAI_API_KEY 仅用于兼容需要 OpenAI 标准变量名的运行时。
SUB2API_API_KEY="replace-with-sub2api-api-key"
# OPENAI_API_KEY="replace-with-sub2api-api-key"

# ── 5. 云 Agent / 集成 OpenCode（dev:stack 必填）────────────────────────
# 与 AI 员工使用独立端口、凭据、工作目录和运行数据。
OPENCODE_INTEGRATION_BASE_URL="http://127.0.0.1:4110"
OPENCODE_INTEGRATION_SERVER_USERNAME="opencode"
OPENCODE_INTEGRATION_SERVER_PASSWORD="replace-with-another-random-64-hex-secret"
# OPENCODE_INTEGRATION_AGENT_CWD="C:/absolute/path/to/harmony-integration-runtime"
# OPENCODE_INTEGRATION_PORT="4110"
# 每个任务 worktree 的父目录；默认使用系统临时目录。
# HARMONY_INTEGRATION_RUNTIME_ROOT="C:/absolute/private/path/harmony-integration-runs"
# 审查输入上限；二进制文件只记录路径与 blob ID，不展开内容。
HARMONY_INTEGRATION_MAX_DIFF_BYTES="2097152"
HARMONY_INTEGRATION_MAX_CHANGED_FILES="120"
# Worker 全局并发范围 1..8，默认 2。
HARMONY_INTEGRATION_WORKER_CONCURRENCY="2"

# ── 6. 类索引与上下文预读（可选，以下均为默认值）────────────────────────
# 扫描根目录来自 workspace-apps.json 的 sources.android.index_roots，不再通过 env 配置。
ANDROID_CLASS_INDEX_TTL_MS="86400000"
ANDROID_CLASS_INDEX_PREWARM_ON_BOOT="0"
ANDROID_CLASS_INDEX_PREWARM_DELAY_MS="5000"
ANDROID_CLASS_PREREAD="1"
ANDROID_CLASS_PREREAD_LINES="200"
ANDROID_CLASS_PREREAD_MAX_FILES="1"
ANDROID_CLASS_PREREAD_MAX_CHARS="8000"

# ── 7. 知识库 MCP 遥测（可选）───────────────────────────────────────────
# 工台内查询直接写数据库；MCP/OpenCode 子进程默认按工台端口推导上报地址。
# KB_TELEMETRY_ENDPOINT="http://127.0.0.1:3100/api/kb-telemetry/v1/events"
# KB_TELEMETRY_API_KEY="replace-with-telemetry-key"
# KB_TELEMETRY_ENABLED="0"

# ── 8. 源码同步 Webhook（启用 Repo Sync 时必填）─────────────────────────
# 仓库匹配、监听分支及变更动作维护在 workspace-apps.json 各资源的 sync 节点。
REPO_SYNC_WEBHOOK_SECRET="replace-with-webhook-secret"
# 多部署实例用于队列归属；不填时使用本机默认标识。
# REPO_SYNC_DEPLOYMENT_ID="local"
# REPO_SYNC_NOTIFY_WEBHOOK="https://example.invalid/bot-webhook"

# ── 9. 包体对比（可选）──────────────────────────────────────────────────
# 多进程部署时必须使用共享、持久化的私有目录；完整规则见 docs/features/package-comparison.md。
# PACKAGE_STORAGE_DIR="C:/absolute/path/to/package-comparison"
# PACKAGE_COMPARISON_CONFIG="C:/absolute/path/to/package-comparison.json"
# PACKAGE_UPLOAD_BYTES="536870912"
# PACKAGE_FILE_BYTES="268435456"
# PACKAGE_EXPANDED_BYTES="2147483648"
# PACKAGE_FILE_COUNT="30000"
# PACKAGE_ANALYSIS_TIMEOUT_MS="180000"
# PACKAGE_ANALYSIS_CONCURRENCY="1"
# PACKAGE_RETENTION_DAYS="30"

# ── 10. 运行工具（可选）─────────────────────────────────────────────────
# Node、pm2 或 OpenCode 不在系统 PATH 时再配置；路径必须是当前机器可访问的绝对路径。
# NODE_BIN_DIR="C:/absolute/path/to/node/bin"
# OPENCODE_HOME="D:/soft/opencode"
# OPENCODE_BIN="D:/soft/opencode/node_modules/opencode-ai/bin/opencode.exe"

# ── 11. 历史任务兼容（新部署不要配置）──────────────────────────────────
# 仅用于读取旧集成任务中已保存的项目 id；新任务完全读取 workspace-apps.json。
# 删除前必须确认数据库中没有依赖旧 id 的历史任务。
# HARMONY_INTEGRATION_PROJECTS='[{"id":"legacy","label":"历史项目","repoRoot":"C:/absolute/path/to/harmony-repo","defaultTargetBranch":"release"}]'

# 12. 云Agent（任务源码和分支仍统一配置在 workspace-apps.json）
# 当前云Agent使用 SSH + 鉴权 MR Webhook，不需要 GitLab API Token。执行机 SSH 必须具有相应仓库读写权限。
# 仅显式使用 delivery.transport=api 的兼容部署需要下项；默认不要配置。Webhook Secret 仍使用源码同步配置。
# CLOUD_AGENT_GITLAB_TOKEN="replace-with-project-api-token"
# 企业微信群机器人密钥URL，仅服务端读取，不放workspace配置、不提交到Git。
# CLOUD_AGENT_WECOM_WEBHOOK="https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=replace-me"
# 无创建人或创建人未配置映射时通知的userid；也可使用DEFAULT_MOBILE，不支持@all。
# CLOUD_AGENT_WECOM_DEFAULT_USER="your-wecom-userid"
# CLOUD_AGENT_WECOM_DEFAULT_MOBILE="13800000000"
# 工台personCode到企业微信身份的显式映射，不假设工号就是userid。
# CLOUD_AGENT_WECOM_USERS='{"employee-code":{"userId":"wecom-userid"}}'
# 团队可访问地址。本地填局域网IP+端口，不填localhost。
# CLOUD_AGENT_PUBLIC_URL="http://192.168.1.10:3100"
# 非默认安装目录必须配置：原生 Harness 据此校验可信工具。填安装根目录，不是 tools；修改后重启 Worker。
# DEVECO_HOME="D:/soft/DevEco Studio"
# 命令行构建必须配置 HarmonyOS SDK 根目录（包含 default/），不是安装根目录或 openharmony/；修改后重启 Worker。
# DEVECO_SDK_HOME="D:/soft/DevEco Studio/sdk"
# 活跃的分析/转译实例数，当前上限 2；人工审批等待不占实例。
# CLOUD_AGENT_CONCURRENCY="2"
# 受管 Git 缓存与 Worker 锁目录；不应放在业务源码目录内。
# CLOUD_AGENT_RUNTIME_ROOT="C:/absolute/path/to/cloud-agent-runtime"
# 源码工作树独立短目录；建议 Windows 使用 C:/kgca/wt。只影响新任务，旧任务需运维迁移。
# CLOUD_AGENT_WORKTREE_ROOT="C:/kgca/wt"
# 不填时使用集成 OpenCode 配置中的网关地址；模型仍由各 App cloud_agent.model 指定。
# CLOUD_AGENT_MODEL_BASE_URL="https://model-gateway.example/v1"
# 附件持久化私有目录，默认 data/cloud-agent/materials；Next.js 与 Worker 必须共用，需配套备份。
# CLOUD_AGENT_MATERIAL_ROOT="C:/absolute/private/path/cloud-agent-materials"
# 视频解析工具，默认从 PATH 查找。仅上传视频需要，不接音频转写。
# CLOUD_AGENT_FFMPEG_BIN="C:/tools/ffmpeg/bin/ffmpeg.exe"
# CLOUD_AGENT_FFPROBE_BIN="C:/tools/ffmpeg/bin/ffprobe.exe"
# Harness 独立包根，默认相邻仓 androidtoharmonyharness/android-harmony-migration-harness。
# CLOUD_AGENT_HARNESS_ROOT="C:/absolute/path/to/android-harmony-migration-harness"
# Harness Python；部署默认用独立受管 venv 安装 Harness requirements.txt 的精确锁定版本。
# 显式指定外部解释器时只校验完整锁文件、pip check、doctor 和视觉预检，不自动安装。
# CLOUD_AGENT_HARNESS_PYTHON="C:/tools/python/python.exe"
# 每轮抽帧安全预算，不是固定采样帧数；模型自主选择时间点与批次，默认120，上限600。
# CLOUD_AGENT_VIDEO_FRAME_BUDGET="120"
# 原型渲染浏览器；不填使用本机 Chrome，需管理员安装。仅静态 HTML，无脚本或外网。
# CLOUD_AGENT_CHROMIUM_BIN="C:/Program Files/Google/Chrome/Application/chrome.exe"
# 新建任务工作区及构建前最低可用空间（GiB，1-1024）；不足时阻塞，不自动删档。
# CLOUD_AGENT_MIN_FREE_GIB="5"
# 空闲任务自动归档无引用的旧构建备份；0 停用。保留天数默认7，归档可恢复，不永久删除验收证据。
# CLOUD_AGENT_ARTIFACT_AUTO_ARCHIVE="1"
# CLOUD_AGENT_ARTIFACT_RETENTION_DAYS="7"
